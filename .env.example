# =============================================================================
# Drishti - AI Video Analytics Configuration
# Copy to .env and adjust values as needed.
# =============================================================================

# --- General ---
APP_NAME=Drishti
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# --- Mock Mode ---
# When true: no GPU required, no large models loaded, returns realistic fake data.
MOCK_MODE=true

# --- Model Configuration ---
MODEL_DEVICE=cuda
# Options: cuda, cpu, mps
LIVE_MODEL=yolo26s
# Path to custom fine-tuned YOLO weights (leave empty for pretrained)
YOLO_CUSTOM_WEIGHTS=
# Path to RT-DETR weights
RTDETR_WEIGHTS=rtdetr-l.pt
# VideoMAE model identifier
VIDEOMAE_MODEL=OpenGVLab/VideoMAEv2-Large
# ViTPose model identifier
VITPOSE_MODEL=nielsr/vitpose-base

# --- Live ROI Detection ---
DEFAULT_OBJECT_CONFIDENCE=0.5
PHONE_CONFIDENCE_THRESHOLD=0.45
CHIT_CONFIDENCE_THRESHOLD=0.40
PROHIBITED_CONFIDENCE_THRESHOLD=0.50
DETECTOR_INPUT_SIZE=640

# --- Trigger System ---
ROI_ACTIVE_DURATION_SECONDS=5
ROI_COOLDOWN_SECONDS=3

# --- Temporal Smoothing ---
# Window size (number of frames) per class
TEMPORAL_WINDOW_PHONE=5
TEMPORAL_WINDOW_CHIT=5
TEMPORAL_WINDOW_BEHAVIOUR=10
# Minimum smoothed confidence to produce evidence
TEMPORAL_THRESHOLD_PHONE=0.6
TEMPORAL_THRESHOLD_CHIT=0.5
TEMPORAL_THRESHOLD_BEHAVIOUR=0.7

# --- Retrospective Verification ---
VERIFICATION_INTERVAL_MINUTES=15
TEMPORAL_SCAN_WINDOW_SECONDS=10
TEMPORAL_SCAN_STRIDE_SECONDS=5
TEMPORAL_TOP_K_WINDOWS=5
TEMPORAL_ANOMALY_THRESHOLD=0.6
VERIFICATION_FRAME_SAMPLE_FPS=2

# --- Evidence ---
EVIDENCE_CLIP_PRE_SECONDS=3
EVIDENCE_CLIP_POST_SECONDS=3

# --- Privacy / Retention ---
RAW_VIDEO_RETENTION_ENABLED=false
EVIDENCE_RETENTION_ENABLED=true
EVIDENCE_RETENTION_HOURS=24

# --- Storage ---
DATABASE_PATH=data/drishti.db
EVIDENCE_STORAGE_PATH=data/evidence

# --- Performance ---
MAX_CONCURRENT_VERIFICATION_JOBS=2
GPU_BATCH_SIZE=4
